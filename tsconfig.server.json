{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist-server",
    "rootDir": "./server",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
