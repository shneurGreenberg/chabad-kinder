# MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/chabad-kinder?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chabad-kinder

# Session secret (generate a random string for production)
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_IN_PRODUCTION

# Master admin password for creating/managing tenants
MASTER_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Trust proxy (set to 1 for Amvera/production behind reverse proxy)
TRUST_PROXY=0

# Base path for URLs (if needed)
# BASE_PATH=/
